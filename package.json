{
  "name": "truepane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsx server/mcp/index.ts",
    "mcp:smoke": "tsx server/mcp/smoke.ts",
    "mcp:build": "esbuild server/mcp/index.ts --bundle --platform=node --format=esm --packages=external --outfile=packages/truepane-mcp/dist/index.js && mkdir -p packages/truepane-mcp/dist/assets && cp -R server/mcp/assets/fonts packages/truepane-mcp/dist/assets/",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^1.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
