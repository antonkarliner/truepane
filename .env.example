# AI prompt→params endpoint (Supabase Edge Function). Copy to `.env` and fill in.
# Without these, the app still works fully — only the "Generate with AI" button is hidden.
VITE_BG_PROMPT_URL=https://YOUR-PROJECT.supabase.co/functions/v1/generator-bg-prompt
# Supabase publishable (anon) key — safe to expose in the client.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional temporary beta password gate. Set to the SHA-256 hash of your
# password to require it before the app loads; leave unset to disable the gate.
# Generate a hash:  printf '%s' 'your-password' | shasum -a 256
VITE_GATE_PASSWORD_HASH=
